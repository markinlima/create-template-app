{
  "$schema": "node_modules/turbo/schema.json",
  "globalPassThroughEnv": ["NODE_ENV"],
  "concurrency": "1",
  "tasks": {
    "lint": {},
    "lint:fix": { "cache": false },
    "ts:check": {},
    "test": {},
    "test:unit": {},
    "build:prepare": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": { "persistent": true, "cache": false }
  }
}
