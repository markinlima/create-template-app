{
	"name": "web-spa",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"--- APP ---": "",
		"dev": "bun run type:generate-types && bun run vite dev",
		"build": "vite build",
		"serve": "vite preview",
		"--- LINT ---": "",
		"format": "biome format --write",
		"lint": "bun run biome lint",
		"check": "biome check --write",
		"check:api": "bun biome check --unsafe --write src/gen/api || echo 'Files fixed!.'",
		"ts:check": "bun check",
		"--- TEST ---": "",
		"test": "vitest run",
		"--- TYPE ---": "",
		"type:generate-types": "bun run type:generate-images-type && bun run type:create-route-tree",
		"type:create-route-tree": "tsr generate",
		"type:generate-images-type": "bun ./scripts/generate-images-type.ts",
		"--- TOOLS ---": "",
		"tool:kubb": "kubb generate --config ./kubb.config.ts && bun ./scripts/patch-kubb.ts && bun check:api",
		"tool:react-dev-tool": "bunx react-devtools",
		"--- SCRIPT ---": "",
		"script:optimize-images": "bun ./scripts/optimize-images.ts && bun run type:generate-images-type",
		"script:generate-openapi": "bun ./scripts/generate-openapi.ts",
		"--- CI ---": "",
		"build:prepare": "bun run type:generate-types && bun run tool:kubb",
		"--- DOCKER ---": "",
		"docker:build": "docker build -f ./dockerfile ${BUILD_ENV_FILE:+--secret id=build-env,src=$BUILD_ENV_FILE} -t \"${TAG_NAME:-web-spa:latest}\" ../../../"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@clack/prompts": "^1.8.1",
		"@fontsource-variable/league-spartan": "^5.3.0",
		"@kubb/cli": "catalog:",
		"@kubb/core": "catalog:",
		"@kubb/plugin-client": "catalog:",
		"@kubb/plugin-oas": "catalog:",
		"@kubb/plugin-react-query": "catalog:",
		"@kubb/plugin-ts": "catalog:",
		"@rolldown/plugin-babel": "^0.2.4",
		"@sentry/react": "^11.1.0",
		"@sentry/vite-plugin": "^5.4.0",
		"@shared/env": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-query-devtools": "^5.104.0",
		"@tanstack/react-router": "^1.170.40",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-cli": "^1.167.39",
		"@tanstack/router-plugin": "^1.168.46",
		"@vitejs/plugin-react": "^6.1.1",
		"@web/alert": "workspace:*",
		"@web/form": "workspace:*",
		"@web/infinite-list": "workspace:*",
		"@web/notification": "workspace:*",
		"@web/shared": "workspace:*",
		"@web/theme": "workspace:*",
		"@web/ui": "workspace:*",
		"axios": "^1.20.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"lucide-react": "^1.48.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-scan": "^0.5.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "catalog:tailwindv4",
		"vite": "^8.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"sharp": "^0.35.5",
		"typescript": "catalog:",
		"vitest": "^5.0.2"
	}
}
