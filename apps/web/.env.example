VITE_API_URL="https://api.example.com"
VITE_FRONTEND_URL="https://example.com"

NODE_ENV="development"
VITE_DEV_MODE=false
VITE_WEB_VERSION="1.0.0"
VITE_API_VERSION="2"
VITE_DEBUG_MODE=false

# ? Umami (web analytics). Both the address and the website id are needed; without them nothing is tracked.
VITE_UMAMI_URL="https://analytics.example.com"
VITE_UMAMI_WEBSITE_ID="RANDOM_CODE"
# ? The file name and the collect address of the Umami server (TRACKER_SCRIPT_NAME and COLLECT_API_ENDPOINT there).
VITE_UMAMI_TRACKER_SCRIPT_NAME="script.js"
VITE_UMAMI_COLLECT_API_ENDPOINT="/api/send"

# ? Error reports use the Sentry SDK. Rustrak speaks the same protocol: the DSN is the one Rustrak gives the project.
VITE_SENTRY_DSN="http://RANDOM_CODE@localhost:8000/1"
# ? Only for uploading source maps at build time (sentry-cli). Empty token = no upload.
VITE_SENTRY_URL="http://localhost:8000"
VITE_SENTRY_ORG="organization"
VITE_SENTRY_PROJECT="project"
SENTRY_AUTH_TOKEN=""
