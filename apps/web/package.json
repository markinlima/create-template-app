{
	"name": "web",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"--- APP ---": "",
		"dev": "bun run type:generate-types && vite dev",
		"build": "vite build",
		"serve": "PORT=${PORT:-5173} bun dist/server/index.mjs",
		"--- API ---": "",
		"type:generate-types": "bun --sequential type:generate-images-type type:create-route-tree",
		"type:create-route-tree": "tsr generate",
		"type:generate-images-type": "bun ./scripts/generate-images-type.ts",
		"tool:kubb": "kubb generate --config ./kubb.config.ts && bun ./scripts/patch-kubb.ts && bun check:api",
		"script:generate-openapi": "bun ./scripts/generate-openapi.ts",
		"build:prepare": "bun --sequential type:generate-types tool:kubb",
		"--- LINTING ---": "",
		"format": "biome format --write",
		"lint": "bun run ts:check && biome lint",
		"lint:fix": "biome check --write",
		"check": "biome check --write",
		"check:api": "bun biome check --unsafe --write src/gen/api",
		"ts:check": "bun check",
		"--- TESTING ---": "",
		"test:unit": "bun test ./src ./server ./scripts",
		"test:integration": "bun test ./test/integration",
		"test": "bun run test:unit",
		"test:all": "bun run test:unit && bun run test:integration",
		"--- UTILS ---": "",
		"tool:react-dev-tool": "bunx react-devtools",
		"script:optimize-images": "bun ./scripts/optimize-images.ts && bun type:generate-images-type",
		"--- DOCKER ---": "",
		"docker:build": "docker build -f ./dockerfile ${BUILD_ENV_FILE:+--secret id=build-env,src=$BUILD_ENV_FILE} -t \"${TAG_NAME:-web:latest}\" ../../",
		"docker:test": "bun ../../scripts/docker/test.ts web"
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"@clack/prompts": "catalog:",
		"@fontsource-variable/league-spartan": "^5.3.0",
		"@kubb/cli": "catalog:",
		"@kubb/core": "catalog:",
		"@kubb/plugin-client": "catalog:",
		"@kubb/plugin-oas": "catalog:",
		"@kubb/plugin-react-query": "catalog:",
		"@kubb/plugin-ts": "catalog:",
		"@rolldown/plugin-babel": "^0.3.1",
		"@sentry/react": "^11.12.0",
		"@sentry/vite-plugin": "^11.12.0",
		"@shared/env": "workspace:*",
		"@shared/utils": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form": "catalog:",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-query-devtools": "^5.104.0",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-router-devtools": "^1.167.3",
		"@tanstack/router-cli": "^1.168.0",
		"@tanstack/router-plugin": "^1.169.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@web/alert": "workspace:*",
		"@web/analytics": "workspace:*",
		"@web/detect-adblock": "workspace:*",
		"@web/form": "workspace:*",
		"@web/infinite-list": "workspace:*",
		"@web/seo": "workspace:*",
		"@web/server": "workspace:*",
		"@web/shared": "workspace:*",
		"@web/theme": "workspace:*",
		"@web/toast": "workspace:*",
		"@web/ui": "workspace:*",
		"@web/update": "workspace:*",
		"axios": "^1.21.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"lucide-react": "catalog:",
		"nitro": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-scan": "^0.5.7",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:tailwindv4",
		"vite": "catalog:",
		"zod": "catalog:",
		"zustand": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"consola": "^3.4.2",
		"nitro": "catalog:",
		"sharp": "^0.35.5",
		"typescript": "catalog:",
		"vite-bundle-analyzer": "^1.3.9",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.2"
	}
}
