{
	"name": "backend",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"--- APP ---": "",
		"start": "NODE_ENV=production bun run src/server.ts",
		"dev": "NODE_ENV=development bun run --watch src/server.ts",
		"--- DATABASE ---": "",
		"db:generate": "bun run --cwd ../../packages/backend/db generate",
		"db:migrate": "bun run --cwd ../../packages/backend/db migrate",
		"db:studio": "bun run --cwd ../../packages/backend/db studio",
		"--- LINTING ---": "",
		"lint": "bun run ts:check && biome check",
		"lint:fix": "biome check --write",
		"ts:check": "tsc --noEmit -p .",
		"check": "biome check --write",
		"--- TESTING ---": "",
		"test": "bun run test:unit",
		"test:unit": "NODE_ENV=test bun test src/utils src/http/plugins",
		"test:e2e": "NODE_ENV=test bun test src/http/routes src/http/openapi.e2e.spec.ts",
		"test:all": "bun run test:unit && bun run test:e2e",
		"--- DOCKER ---": "",
		"docker:build": "docker build -f ./dockerfile -t \"${TAG_NAME:-backend:latest}\" ../../",
		"docker:test": "bun ../../scripts/docker/test.ts backend"
	},
	"dependencies": {
		"@backend/db": "workspace:*",
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/openapi": "^1.4.14",
		"@sentry/elysia": "^10.75.3",
		"@shared/env": "workspace:*",
		"@shared/routes": "workspace:*",
		"better-auth": "^1.6.11",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"elysia": "^1.4.22",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"openapi-types": "^12.1.3",
		"typescript": "catalog:"
	}
}
