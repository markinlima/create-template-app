# ? Copy to `.env` and fill it in. Every value here is a placeholder.
NODE_ENV="development"
PORT=3333

# ? The Postgres of docker-compose.services.yml (host `postgres` inside the dev container; `localhost` when it runs on your machine) (or any Postgres 18: `uuidv7()` is used by the default ids).
DATABASE_URL="postgres://app:app@postgres:5432/app"
# ? Applies the pending migrations when the server starts (run `bun run db:migrate` yourself otherwise).
RUN_MIGRATIONS=true

# ? Better Auth signs the session cookies with this secret: at least 32 random characters.
BETTER_AUTH_SECRET="change-me-to-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3333"
# ? The web app origins allowed to call the API with cookies, comma separated.
CORS_ORIGIN="http://localhost:5173"
# ? True only when the API and the web app run on HTTPS (cookies become SameSite=None; Secure).
IS_DEPLOYED=false
