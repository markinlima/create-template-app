{
  "name": "create-template-app",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "private": true,
  "scripts": {
    "--- DEVELOPMENT ---": "",
    "build:prepare": "turbo run build:prepare",
    "ci:act": "act",
    "--- SCRIPT ---": "",
    "script:setup-project": "bun ./scripts/docker/setup.ts",
    "script:test-project": "bun ./scripts/docker/test.ts",
    "script:clear-project": "bun ./scripts/clear.ts",
    "script:qa-chrome": "bun ./scripts/qa-chrome.ts",
    "--- LINTING ---": "",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "ts:check": "turbo run ts:check",
    "typecheck": "bun run ts:check",
    "ci:lint": "actionlint",
    "ci:check": "bun run --cwd .github/scripts ts:check && bun run --cwd .github/scripts test",
    "--- TESTING ---": "",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:scripts": "bun test ./scripts ./.github/scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@clack/prompts": "catalog:",
    "@types/bun": "catalog:",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@casl/ability": "^7.0.2",
      "@clack/prompts": "^1.9.0",
      "@faker-js/faker": "^10.6.0",
      "@kubb/cli": "^4.39.3",
      "@kubb/core": "^4.39.3",
      "@kubb/plugin-client": "^4.39.3",
      "@kubb/plugin-oas": "^4.39.3",
      "@kubb/plugin-react-query": "^4.39.3",
      "@kubb/plugin-ts": "^4.39.3",
      "@tanstack/markdown": "^1.0.0",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-hotkeys": "^0.15.0",
      "@tanstack/react-query": "^5.107.1",
      "@tanstack/react-router": "^1.170.46",
      "@types/bun": "1.4.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "dayjs": "^1.11.23",
      "lucide-react": "^1.72.0",
      "nitro": "3.0.261103-rc",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "tailwind-variants": "^4.0.2",
      "typescript": "^7.0.2",
      "vite": "^8.3.8",
      "zod": "^4.6.7",
      "zustand": "^5.0.16"
    },
    "catalogs": {
      "tailwindv4": {
        "tailwindcss": "^4.3.3"
      }
    }
  }
}
